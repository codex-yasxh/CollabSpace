{
  "name": "collabspace",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run dev -w server\" \"npm run dev -w client\"",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w client",
    "lint": "eslint .",
    "test": "npm run test -w server --if-present && npm run test -w client --if-present",
    "build": "npm run build -w client",
    "start": "npm run migrate && tsx server/src/index.ts",
    "migrate": "npm run migrate -w server",
    "seed": "npm run seed -w server"
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "puppeteer-core": "^25.18.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0"
  },
  "optionalDependencies": {
    "@rolldown/binding-win32-x64-msvc": "^1.3.3",
    "lightningcss-win32-x64-msvc": "^1.33.0"
  }
}
